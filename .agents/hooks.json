{
  "git-branch-and-push-guard": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "~/.gemini/config/scripts/pre-tool-guard.sh",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
